# Generate with: openssl rand -hex 16
LIBREDESK_ENCRYPTION_KEY=

# Required for production. Pin both a release tag and its manifest digest.
# Example: ghcr.io/owner/image:v2.5.2@sha256:<64-hex-digest>
LIBREDESK_IMAGE=

# Use independent random values; do not reuse the application encryption key.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Optional initial system administrator password.
LIBREDESK_SYSTEM_USER_PASSWORD=

TURNSTILE_SITE_KEY=your_site_key
TURNSTILE_SECRET_KEY=your_secret_key
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_VERIFY_TIMEOUT_MS=5000
REGISTER_RATE_LIMIT_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=5
LIBREDESK_HOST_BIND_IP=127.0.0.1
LIBREDESK_UPLOAD__MAX_TOTAL_FILES=100000
LIBREDESK_UPLOAD__MAX_TOTAL_SIZE_BYTES=53687091200
LIBREDESK_UPLOAD__MIN_FREE_SIZE_BYTES=1073741824
